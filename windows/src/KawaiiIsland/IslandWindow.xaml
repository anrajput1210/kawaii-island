<Window x:Class="KawaiiIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:KawaiiIsland.Controls"
        Title="Kawaii Island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True">
    <!-- The window is sized for the expanded island + shadow; fully transparent pixels are click-through,
         so only the pill itself receives input. The pill grows from its top-centre. -->
    <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
            Background="{DynamicResource IslandBackground}" RenderTransformOrigin="0.5,0" Cursor="Hand">
        <Border.RenderTransform>
            <ScaleTransform x:Name="HoverScale"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="Shadow" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid ClipToBounds="True">
            <!-- Collapsed: mascot + clock -->
            <Grid x:Name="CollapsedPanel" Margin="11,0">
                <c:MascotControl x:Name="MascotSmall" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="Clock" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource IslandText}" FontFamily="{DynamicResource IslandFont}"
                           FontWeight="SemiBold" FontSize="13"/>
            </Grid>

            <!-- Expanded: laid out at its final size and revealed as the pill grows (no reflow while animating).
                 Modules (music, mail, alerts, apps) replace the greeting in Phases 7–10. -->
            <Grid x:Name="ExpandedPanel" Visibility="Collapsed" Opacity="0"
                  HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel x:Name="ExpandedItems" Margin="18,14,18,14">
                    <DockPanel>
                        <c:MascotControl x:Name="MascotLarge" DockPanel.Dock="Right" Width="40" Height="40" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock x:Name="BigClock" Foreground="{DynamicResource IslandText}" FontFamily="{DynamicResource IslandFont}"
                                       FontWeight="SemiBold" FontSize="34"/>
                            <TextBlock x:Name="DateText" Foreground="{DynamicResource IslandMuted}" FontFamily="{DynamicResource IslandFont}" FontSize="13"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Margin="0,14,0,0" Text="Hi! Nothing new right now." Foreground="{DynamicResource IslandMuted}"
                               FontFamily="{DynamicResource IslandFont}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
