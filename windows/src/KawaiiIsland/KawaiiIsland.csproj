<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>KawaiiIsland</AssemblyName>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- required by [LibraryImport] source-generated P/Invoke -->
  </PropertyGroup>

  <!-- OAuth app registrations for "Sign in with Google / Microsoft", baked in at build time by whoever ships the app
       (env vars, never committed). Users never register anything. Empty = sign-in unavailable in that build. -->
  <ItemGroup>
    <AssemblyMetadata Include="GoogleClientId" Value="$(KAWAII_GOOGLE_CLIENT_ID)" />
    <AssemblyMetadata Include="GoogleClientSecret" Value="$(KAWAII_GOOGLE_CLIENT_SECRET)" />
    <AssemblyMetadata Include="MicrosoftClientId" Value="$(KAWAII_MICROSOFT_CLIENT_ID)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <InternalsVisibleTo Include="KawaiiIsland.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

</Project>
