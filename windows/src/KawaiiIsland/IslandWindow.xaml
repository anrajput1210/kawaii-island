<Window x:Class="KawaiiIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:KawaiiIsland.Controls"
        Title="Kawaii Island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- Round icon button (media controls). Glyphs: Segoe Fluent Icons on Windows 11, MDL2 on 10. -->
        <Style x:Key="Glyph" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource IslandText}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="99" Padding="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource IslandTrack}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Rounded text button (notification actions). -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource IslandText}"/>
            <Setter Property="FontFamily" Value="{DynamicResource IslandFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource IslandTrack}" CornerRadius="99" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Expanded-view tabs (only shown when more than one module has something to show). -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource IslandMuted}"/>
            <Setter Property="FontFamily" Value="{DynamicResource IslandFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="99" Padding="9,3" Margin="0,0,2,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource IslandText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource IslandTrack}"/>
                                <Setter Property="Foreground" Value="{DynamicResource IslandText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- The window is sized for the expanded island + shadow; fully transparent pixels are click-through,
         so only the pill itself receives input. The pill grows from its top-centre. -->
    <Grid>
    <!-- Dashed outline shown while unlocked (drag mode). -->
    <Rectangle x:Name="Outline" Visibility="Collapsed" IsHitTestVisible="False"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"
               Stroke="{DynamicResource Accent}" StrokeThickness="1.5" StrokeDashArray="3 2.5"/>
    <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
            Background="{DynamicResource IslandBackground}" RenderTransformOrigin="0.5,0" Cursor="Hand">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="HoverScale"/>
                <!-- Auto-hide: slides the pill off the docked edge (clipped by the window) -->
                <TranslateTransform x:Name="HideShift"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="Shadow" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid ClipToBounds="True">
            <!-- Collapsed: mascot + clock -->
            <Grid x:Name="CollapsedPanel" Margin="11,0">
                <c:MascotControl x:Name="MascotSmall" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <!-- Code mode: status dot + what Claude is doing (compact 280x40 pill) -->
                <StackPanel x:Name="CodeLinePanel" Orientation="Horizontal" Margin="32,0,72,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <Ellipse x:Name="CodeDot" Width="7" Height="7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CodeLine" Margin="7,0,0,0" Foreground="{DynamicResource IslandText}" FontFamily="{DynamicResource IslandFont}"
                               FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                </StackPanel>
                <!-- New notification (compact 280x40, ~4 s): app icon + title + body; the mascot moves to the right -->
                <StackPanel x:Name="NotifLinePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid Width="24" Height="24">
                        <Border x:Name="NotifIconBg" CornerRadius="7">
                            <TextBlock x:Name="NotifLetter" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="NotifIcon" CornerRadius="7"/>
                    </Grid>
                    <TextBlock x:Name="NotifLine" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="190" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource IslandFont}" FontSize="12">
                        <Run x:Name="NotifLineTitle" FontWeight="SemiBold" Foreground="{DynamicResource IslandText}"/>
                        <Run x:Name="NotifLineBody" Foreground="{DynamicResource IslandMuted}"/>
                    </TextBlock>
                </StackPanel>
                <!-- Music (compact 280x40): album art + title, live equalizer on the right -->
                <StackPanel x:Name="MusicLinePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border x:Name="MiniArt" Width="26" Height="26" CornerRadius="6"/>
                    <TextBlock x:Name="MusicLine" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource IslandText}"
                               FontFamily="{DynamicResource IslandFont}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="185"/>
                </StackPanel>
                <StackPanel x:Name="Eq" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="16" Visibility="Collapsed"/>
                <TextBlock x:Name="Clock" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource IslandText}" FontFamily="{DynamicResource IslandFont}"
                           FontWeight="SemiBold" FontSize="13"/>
            </Grid>

            <!-- Expanded: laid out at its final size and revealed as the pill grows (no reflow while animating).
                 Modules (music, mail, alerts, apps) replace the greeting in Phases 7–10. -->
            <Grid x:Name="ExpandedPanel" Visibility="Collapsed" Opacity="0"
                  HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel x:Name="ExpandedItems" Margin="18,14,18,14">
                    <!-- Header for module views: tabs (when needed) + small clock + mascot -->
                    <DockPanel x:Name="TabRow" Margin="0,0,0,8" Visibility="Collapsed">
                        <c:MascotControl x:Name="MascotTiny" DockPanel.Dock="Right" Width="22" Height="22" Margin="8,0,0,0"/>
                        <TextBlock x:Name="SmallClock" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource IslandMuted}"
                                   FontFamily="{DynamicResource IslandFont}" FontSize="12" FontWeight="SemiBold"/>
                        <StackPanel x:Name="Tabs" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="TabMusic" Content="Music" Style="{StaticResource Tab}" GroupName="view"/>
                            <RadioButton x:Name="TabCode" Content="Code" Style="{StaticResource Tab}" GroupName="view"/>
                            <RadioButton x:Name="TabAlerts" Content="Alerts" Style="{StaticResource Tab}" GroupName="view"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel x:Name="MainRow">
                        <c:MascotControl x:Name="MascotLarge" DockPanel.Dock="Right" Width="40" Height="40" VerticalAlignment="Top"/>
                        <StackPanel x:Name="ClockBlock">
                            <TextBlock x:Name="BigClock" Foreground="{DynamicResource IslandText}" FontFamily="{DynamicResource IslandFont}"
                                       FontWeight="SemiBold" FontSize="34"/>
                            <TextBlock x:Name="DateText" Foreground="{DynamicResource IslandMuted}" FontFamily="{DynamicResource IslandFont}" FontSize="13"/>
                        </StackPanel>
                        <!-- Code mode header -->
                        <StackPanel x:Name="CodeHeader" Visibility="Collapsed">
                            <TextBlock x:Name="CodeTitle" Foreground="{DynamicResource IslandText}" FontFamily="{DynamicResource IslandFont}"
                                       FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Ellipse x:Name="CodeDotLarge" Width="8" Height="8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CodeStateText" Margin="7,0,0,0" Foreground="{DynamicResource IslandText}" FontFamily="{DynamicResource IslandFont}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="Greeting" Margin="0,14,0,0" Text="Hi! Nothing new right now." Foreground="{DynamicResource IslandMuted}"
                               FontFamily="{DynamicResource IslandFont}" FontSize="12"/>
                    <!-- Code mode: context / 5-hour / weekly meters (built in IslandWindow.Code.cs) -->
                    <UniformGrid x:Name="CodeMeters" Columns="3" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="CodeFooter" Margin="0,10,0,0" Visibility="Collapsed" Foreground="{DynamicResource IslandMuted}"
                               FontFamily="{DynamicResource IslandFont}" FontSize="11"/>

                    <!-- Music (spec §3.3): art + title/artist + EQ, progress, controls. Follows the system's current media session. -->
                    <StackPanel x:Name="MusicPanel" Visibility="Collapsed">
                        <DockPanel>
                            <Grid Width="46" Height="46">
                                <Border x:Name="ArtPlaceholder" CornerRadius="10">
                                    <TextBlock Text="&#x266A;" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BigArt" CornerRadius="10"/>
                            </Grid>
                            <StackPanel x:Name="BigEq" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Height="16"/>
                            <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SongTitle" Foreground="{DynamicResource IslandText}" FontFamily="{DynamicResource IslandFont}"
                                           FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SongArtist" Margin="0,2,0,0" Foreground="{DynamicResource IslandMuted}" FontFamily="{DynamicResource IslandFont}"
                                           FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="PosText" Width="34" Foreground="{DynamicResource IslandMuted}" FontFamily="{DynamicResource IslandFont}" FontSize="10.5"/>
                            <TextBlock x:Name="RemText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Foreground="{DynamicResource IslandMuted}"
                                       FontFamily="{DynamicResource IslandFont}" FontSize="10.5"/>
                            <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Margin="4,0" Background="{DynamicResource IslandTrack}">
                                <Border x:Name="ProgressFill" CornerRadius="2" HorizontalAlignment="Left" Width="0" Background="{DynamicResource IslandText}"/>
                            </Border>
                        </DockPanel>
                        <Grid Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="PrevButton" Style="{StaticResource Glyph}" Content="&#xE892;" FontSize="16" ToolTip="Previous" AutomationProperties.Name="Previous"/>
                                <Button x:Name="PlayButton" Style="{StaticResource Glyph}" Content="&#xE768;" FontSize="20" Margin="14,0" ToolTip="Play/pause" AutomationProperties.Name="Play or pause"/>
                                <Button x:Name="NextButton" Style="{StaticResource Glyph}" Content="&#xE893;" FontSize="16" ToolTip="Next" AutomationProperties.Name="Next"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Alerts (spec §3.2): one notification at a time, ‹ › through the last 20 -->
                    <StackPanel x:Name="AlertsPanel" Visibility="Collapsed">
                        <DockPanel>
                            <Grid Width="36" Height="36" VerticalAlignment="Top">
                                <Border x:Name="AlertIconBg" CornerRadius="10">
                                    <TextBlock x:Name="AlertLetter" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="AlertIcon" CornerRadius="10"/>
                            </Grid>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock x:Name="AlertMeta" Foreground="{DynamicResource IslandMuted}" FontFamily="{DynamicResource IslandFont}" FontSize="10.5"/>
                                <TextBlock x:Name="AlertTitle" Foreground="{DynamicResource IslandText}" FontFamily="{DynamicResource IslandFont}"
                                           FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AlertBody" Foreground="{DynamicResource IslandMuted}" FontFamily="{DynamicResource IslandFont}" FontSize="11.5"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="15" LineStackingStrategy="BlockLineHeight" MaxHeight="30"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="AlertPrev" Style="{StaticResource Glyph}" Content="&#xE76B;" FontSize="11" ToolTip="Newer" AutomationProperties.Name="Newer notification"/>
                                <TextBlock x:Name="AlertPos" VerticalAlignment="Center" MinWidth="34" TextAlignment="Center" Foreground="{DynamicResource IslandMuted}"
                                           FontFamily="{DynamicResource IslandFont}" FontSize="11"/>
                                <Button x:Name="AlertNext" Style="{StaticResource Glyph}" Content="&#xE76C;" FontSize="11" ToolTip="Older" AutomationProperties.Name="Older notification"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MuteAppButton" Style="{StaticResource PillButton}"/>
                                <Button x:Name="ClearAlertsButton" Style="{StaticResource PillButton}" Content="Clear all" Margin="8,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <!-- Auto-hidden: 3 px hover strip on the docked edge (alpha 1/255 so it still gets the mouse). -->
    <Border x:Name="EdgeStrip" Background="#01000000" Visibility="Collapsed"/>

    <!-- Auto-hidden + pointer on the edge: the mascot peeks out and says hi; clicking it opens the island. -->
    <StackPanel x:Name="Peek" Orientation="Horizontal" Visibility="Collapsed" Cursor="Hand"
                AutomationProperties.Name="Open the island">
        <StackPanel.RenderTransform>
            <TranslateTransform x:Name="PeekShift"/>
        </StackPanel.RenderTransform>
        <c:MascotControl x:Name="PeekMascot" Width="46" Height="46" Expression="wow"/>
        <Border x:Name="PeekBubble" Margin="4,0" Padding="10,4" CornerRadius="12,12,12,4" Background="White" Opacity="0">
            <TextBlock Text="hi 👋" Foreground="#2B2B4A" FontFamily="{DynamicResource IslandFont}" FontSize="12" FontWeight="Bold"/>
        </Border>
    </StackPanel>
    </Grid>
</Window>
