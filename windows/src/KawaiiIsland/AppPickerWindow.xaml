<Window x:Class="KawaiiIsland.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add apps to the island" Width="380" Height="520"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="Transparent" Foreground="#FFFFFF"
        FontFamily="{DynamicResource IslandFont}" FontSize="13" UseLayoutRounding="True">
    <!-- Apple-style dark glass drop-down: the Windows 11 acrylic backdrop (blur) shows through a black tint;
         Windows 10 has no backdrop and just gets the tint over black. -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#8E8E93"/>
        <!-- App row: icon + name; hover/selected = faint white wash (no pill) -->
        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="7" Padding="10,6" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Plain text button: no background shape; hover brightens, disabled dims -->
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="Panel" Background="#B8000000" CornerRadius="8" RenderTransformOrigin="0.5,0" Opacity="0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Scale" ScaleX="0.96" ScaleY="0.96"/>
                <TranslateTransform x:Name="Slide" Y="-10"/>
            </TransformGroup>
        </Border.RenderTransform>
        <DockPanel Margin="14,14,14,10">
            <TextBlock DockPanel.Dock="Top" Text="Add apps" FontSize="17" FontWeight="SemiBold" Margin="4,0,0,10"/>
            <Border DockPanel.Dock="Top" Background="#1FFFFFFF" CornerRadius="8" Margin="0,0,0,8">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource Muted}"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock x:Name="Hint" Text="Search" Foreground="{StaticResource Muted}" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="Search" Padding="28,7,8,7" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                             BorderThickness="0" AutomationProperties.Name="Search apps"/>
                </Grid>
            </Border>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Add" FontWeight="SemiBold" Foreground="#FFFFFF"
                        IsDefault="True" IsEnabled="False"/>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Cancel"/>
                <Button x:Name="BrowseButton" Style="{StaticResource Link}" Content="Browse for a file…" HorizontalAlignment="Left"
                        ToolTip="Pin any program, document or folder that isn't in the list"/>
            </DockPanel>
            <Grid>
                <TextBlock x:Name="Loading" Text="Loading your apps…" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ListBox x:Name="List" SelectionMode="Extended" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" ItemContainerStyle="{StaticResource Row}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Installed apps">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Border>
</Window>
