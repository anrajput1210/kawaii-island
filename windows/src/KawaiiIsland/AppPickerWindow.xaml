<Window x:Class="KawaiiIsland.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add apps to the island" Width="460" Height="600" MinWidth="380" MinHeight="380"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="{DynamicResource SettingsBackground}" Foreground="{DynamicResource IslandText}"
        FontFamily="{DynamicResource IslandFont}" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <!-- App row: icon + name; selected = soft panel + bold (no pill) -->
        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SettingsPanel}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SettingsLine}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Add apps" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,12" Foreground="{DynamicResource IslandMuted}" TextWrapping="Wrap"
                   Text="Pick from your installed apps. Ctrl+click to choose several; double-click adds one right away."/>
        <TextBox x:Name="Search" DockPanel.Dock="Top" Padding="10,7" Margin="0,0,0,10"
                 Background="{DynamicResource SettingsPanel}" Foreground="{DynamicResource IslandText}" BorderBrush="{DynamicResource SettingsLine}"
                 AutomationProperties.Name="Search apps"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add" IsDefault="True" Padding="22,6" IsEnabled="False"/>
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
            <Button x:Name="BrowseButton" Content="Browse for a file…" HorizontalAlignment="Left" Padding="12,6"
                    ToolTip="Pin any program, document or folder that isn't in the list"/>
        </DockPanel>
        <Grid>
            <TextBlock x:Name="Loading" Text="Loading your apps…" Foreground="{DynamicResource IslandMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ListBox x:Name="List" SelectionMode="Extended" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Row}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Installed apps">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource IslandMuted}" FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
